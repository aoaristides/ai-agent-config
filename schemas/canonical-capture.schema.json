{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-agent-config:schema:canonical-capture:1.0",
  "title": "CanonicalCapture",
  "description": "Provenance and user-provided text or Markdown captured from a conversational source for inbox review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_id",
    "captured_at",
    "source",
    "content"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "capture_id": {
      "type": "string",
      "format": "uuid"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "title"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Provider-neutral source identifier, such as chatgpt, claude-chat, codex, or another slug. No provider-specific behavior is implied."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "Absolute HTTP(S) link to the source conversation, when available."
        }
      }
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "description": "Text or Markdown provided by the user. Inbox captures may contain source conversation content and must be reviewed before promotion to a knowledge note."
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Provisional capture classification; it does not replace the vault note type."
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
